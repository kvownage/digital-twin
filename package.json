{
  "name": "supervisorio-gp12",
  "version": "0.1.0",
  "description": "Supervisorio web 3D do Motoman GP12 - Node.js + React + TypeScript + three.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n servidor,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "gateway": "tsx gateway/index.ts",
    "pacote-gateway": "esbuild gateway/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-gateway/index.cjs --external:serialport --external:@serialport/* && esbuild gateway/testa-modbus.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-gateway/testa-modbus.cjs --external:serialport --external:@serialport/*",
    "clp-falso": "tsx gateway/clp-falso.ts",
    "testa-modbus": "tsx gateway/testa-modbus.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.8",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "modbus-serial": "^8.0.17",
    "mqtt": "^5.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.168.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.168.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "aedes": "^1.1.1",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
