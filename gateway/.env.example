# ===== Gateway da Celula R-01: CLP -> MQTT =====

# CLP: o IP do S7 na rede.
#
# PORTA 503, nao 502: a 502 e da BALANCA e fica exclusiva dela. Com as duas
# instancias MB_SERVER na mesma porta, o gateway poderia ocupar as duas vagas
# numa reconexao e derrubar a balanca. Porta separada = vaga reservada.
#
# PLC_UNIT nao importa em Modbus TCP — o MB_SERVER da Siemens nao filtra por
# Unit ID (conferido no DB de instancia do projeto). Deixe 1.
PLC_IP=192.168.0.10
PLC_PORT=503
PLC_UNIT=1

# Broker MQTT. A credencial vai SEPARADA da URL de proposito: senha com
# @ : / # nao sobrevive dentro de uma URL.
#
# O host abaixo e o cluster HiveMQ da celula — ja preenchido, nao mexer.
MQTT_URL=mqtts://9dd637379bc94f2b89b23b6ec264fd19.s1.eu.hivemq.cloud:8883
MQTT_USER=celula-r01
MQTT_PASS=
MQTT_TOPICO=multilaser/paletizadora/r01/estado
